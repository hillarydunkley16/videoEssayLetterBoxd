# Backend environment — copy to backend/.env for local overrides, or set these
# as environment variables on Render. With NONE of these set the app runs as a
# local dev server (DEBUG on, SQLite, permissive CORS, Clerk dev instance).
# See DEPLOY.md for where each production value comes from.

# --- Core -------------------------------------------------------------
# Leave DJANGO_DEBUG empty for local dev. In production it is forced off as soon
# as DJANGO_SECRET_KEY is set; set DJANGO_DEBUG=false to be explicit.
DJANGO_DEBUG=
# Required when DEBUG is off. python -c "import secrets;print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
# Comma-separated hostnames, no scheme. e.g. my-api.onrender.com
DJANGO_ALLOWED_HOSTS=
# Comma-separated origins for authenticated POSTs. e.g. https://my-api.onrender.com
DJANGO_CSRF_TRUSTED_ORIGINS=

# --- HTTPS / HSTS (only applied when DEBUG is off) -------------------
DJANGO_SECURE_SSL_REDIRECT=
# Seconds; default 3600. Set 0 to disable HSTS.
DJANGO_SECURE_HSTS_SECONDS=

# --- CORS -----------------------------------------------------------
# Comma-separated origins the browser app is served from. e.g. https://my-web.onrender.com
CORS_ALLOWED_ORIGINS=

# --- Database -----------------------------------------------------
# Full connection URL. Unset -> local SQLite. e.g. postgres://user:pass@host:5432/dbname
DATABASE_URL=

# --- Clerk auth -------------------------------------------------
# Production Clerk instance issuer URL. Required when DEBUG is off.
CLERK_ISSUER=
# Optional second issuer accepted during dev -> prod cutover.
CLERK_ISSUER_LEGACY=
# Seconds to cache Clerk's JWKS. Default 600.
CLERK_JWKS_CACHE_TTL=

# --- Third-party APIs ---------------------------------------
# SerpAPI key for YouTube search (https://serpapi.com/manage-api-key).
SERPAPI_KEY=
