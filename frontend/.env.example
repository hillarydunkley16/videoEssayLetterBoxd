# Frontend environment — copy to frontend/.env for local dev, or set these on the
# Render static site. EXPO_PUBLIC_* vars are inlined into the web bundle at build
# time — they are NOT secret (anything here ships to the browser).

# Deployed backend root URL (no trailing slash, no /api).
# Unset -> src/api/client.ts falls back to local-network discovery for dev.
EXPO_PUBLIC_API_BASE_URL=https://videoessay-backend.onrender.com

# Clerk publishable key (pk_test_... for the dev instance used by the beta).
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=
